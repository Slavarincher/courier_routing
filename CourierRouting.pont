(defclass Participant "Участник процесса доставки"
	(is-a USER)
	(role abstract)
	(single-slot fullName
;+		(comment "ФИО")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write))
	(single-slot phone
;+		(comment "Телефон")
		(type STRING)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass Dispatcher "Диспетчер"
	(is-a Participant)
	(role concrete)
	(multislot manages
;+		(comment "Диспетчер управляет маршрутами")
		(type INSTANCE)
